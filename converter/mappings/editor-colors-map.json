{
  "_comment": "VSCode workbench colors -> editor scheme. 'colors' go to <colors>; 'attributes' to <attributes>. Values are expressions (see src/expr.js); colors are composed over editor.background unless {\"keepAlpha\": true} (only ScrollBar.* accept RGBA). \"\" writes an empty value.",

  "colors": {
    "CARET_COLOR": "@editorCursor.foreground",
    "CARET_ROW_COLOR": "@editor.lineHighlightBackground",
    "GUTTER_BACKGROUND": "@editorGutter.background|@editor.background",
    "EDITOR_GUTTER_BACKGROUND": "@editorGutter.background|@editor.background",
    "CONSOLE_BACKGROUND_KEY": "@terminal.background|@panel.background|@editor.background",
    "SELECTION_BACKGROUND": "@editor.selectionBackground",
    "SELECTION_BACKGROUND_INACTIVE": "@editor.inactiveSelectionBackground|@editor.selectionBackground",
    "SELECTION_FOREGROUND": "",
    "LINE_NUMBERS_COLOR": "@editorLineNumber.foreground",
    "LINE_NUMBER_ON_CARET_ROW_COLOR": "@editorActiveLineNumber.foreground|@editorLineNumber.activeForeground",
    "INDENT_GUIDE": "@editorIndentGuide.background",
    "SELECTED_INDENT_GUIDE": "@editorIndentGuide.activeBackground",
    "MATCHED_BRACES_INDENT_GUIDE_COLOR": "@editorIndentGuide.activeBackground",
    "WHITESPACES": "@editorWhitespace.foreground",
    "SOFT_WRAP_SIGN_COLOR": "@editorWhitespace.foreground",
    "RIGHT_MARGIN_COLOR": "@editorRuler.foreground",
    "VISUAL_INDENT_GUIDE": "@editorRuler.foreground",
    "TEARLINE_COLOR": "@editorGroup.border|@dropdown.border",
    "SELECTED_TEARLINE_COLOR": "@focusBorder",
    "METHOD_SEPARATORS_COLOR": "@editorGroup.border|@dropdown.border",
    "DOCUMENTATION_COLOR": "@editorHoverWidget.background",
    "INFORMATION_HINT": "@editorHoverWidget.background",
    "QUESTION_HINT": "@editorHoverWidget.background",
    "ERROR_HINT": "@inputValidation.errorBackground",
    "HINT_BORDER": "@editorHoverWidget.border",
    "LOOKUP_COLOR": "@editorSuggestWidget.background",
    "NOTIFICATION_BACKGROUND": "@editorWidget.background",
    "READONLY_FRAGMENT_BACKGROUND": "@editor.rangeHighlightBackground",
    "FOLDED_TEXT_BORDER_COLOR": "@editorWhitespace.foreground",
    "ANNOTATIONS_COLOR": "@editorLineNumber.foreground",
    "ADDED_LINES_COLOR": "@editorGutter.addedBackground|@gitDecoration.untrackedResourceForeground",
    "MODIFIED_LINES_COLOR": "@editorGutter.modifiedBackground|@gitDecoration.modifiedResourceForeground",
    "DELETED_LINES_COLOR": "@editorGutter.deletedBackground|@errorForeground",
    "FILESTATUS_MODIFIED": "@gitDecoration.modifiedResourceForeground",
    "FILESTATUS_UNKNOWN": "@gitDecoration.untrackedResourceForeground",
    "FILESTATUS_ADDED": "@gitDecoration.addedResourceForeground|@gitDecoration.untrackedResourceForeground",
    "FILESTATUS_DELETED": "@gitDecoration.deletedResourceForeground",
    "FILESTATUS_IDEA_FILESTATUS_IGNORED": "@gitDecoration.ignoredResourceForeground",
    "FILESTATUS_IDEA_FILESTATUS_MERGED_WITH_CONFLICTS": "@gitDecoration.conflictingResourceForeground",
    "ScrollBar.thumbColor": { "value": "@scrollbarSlider.background", "keepAlpha": true },
    "ScrollBar.hoverThumbColor": { "value": "@scrollbarSlider.hoverBackground", "keepAlpha": true },
    "ScrollBar.Mac.thumbColor": { "value": "@scrollbarSlider.background", "keepAlpha": true },
    "ScrollBar.Mac.hoverThumbColor": { "value": "@scrollbarSlider.hoverBackground", "keepAlpha": true },
    "ScrollBar.Transparent.thumbColor": { "value": "@scrollbarSlider.background", "keepAlpha": true },
    "ScrollBar.Transparent.hoverThumbColor": { "value": "@scrollbarSlider.hoverBackground", "keepAlpha": true },
    "ScrollBar.Mac.Transparent.thumbColor": { "value": "@scrollbarSlider.background", "keepAlpha": true },
    "ScrollBar.Mac.Transparent.hoverThumbColor": { "value": "@scrollbarSlider.hoverBackground", "keepAlpha": true }
  },

  "attributes": {
    "SEARCH_RESULT_ATTRIBUTES": { "BACKGROUND": "@editor.findMatchHighlightBackground|@editor.findMatchBackground" },
    "TEXT_SEARCH_RESULT_ATTRIBUTES": { "BACKGROUND": "@editor.findMatchBackground", "FOREGROUND": "@activityBarBadge.foreground|@editor.background" },
    "WRITE_SEARCH_RESULT_ATTRIBUTES": { "BACKGROUND": "@editor.findMatchHighlightBackground|@editor.findMatchBackground" },
    "IDENTIFIER_UNDER_CARET_ATTRIBUTES": { "BACKGROUND": "@editor.wordHighlightBackground" },
    "WRITE_IDENTIFIER_UNDER_CARET_ATTRIBUTES": { "BACKGROUND": "@editor.wordHighlightStrongBackground|@editor.selectionHighlightBackground" },
    "MATCHED_BRACE_ATTRIBUTES": { "BACKGROUND": "@editorBracketMatch.background", "EFFECT_COLOR": "@editorBracketMatch.border", "EFFECT_TYPE": 0 },
    "CTRL_CLICKABLE": { "FOREGROUND": "@editorLink.activeForeground|@textLink.activeForeground", "EFFECT_COLOR": "@editorLink.activeForeground|@textLink.activeForeground", "EFFECT_TYPE": 1 },
    "HYPERLINK_ATTRIBUTES": { "FOREGROUND": "@textLink.foreground|@editorLink.activeForeground", "EFFECT_COLOR": "@textLink.foreground|@editorLink.activeForeground", "EFFECT_TYPE": 1 },
    "FOLLOWED_HYPERLINK_ATTRIBUTES": { "FOREGROUND": "@textLink.activeForeground|@editorLink.activeForeground", "EFFECT_COLOR": "@textLink.activeForeground|@editorLink.activeForeground", "EFFECT_TYPE": 1 },
    "ERRORS_ATTRIBUTES": { "EFFECT_COLOR": "@editorError.foreground|@errorForeground", "EFFECT_TYPE": 2, "ERROR_STRIPE_COLOR": "@editorError.foreground|@errorForeground" },
    "WARNING_ATTRIBUTES": { "EFFECT_COLOR": "@editorWarning.foreground|@gitDecoration.modifiedResourceForeground", "EFFECT_TYPE": 2, "ERROR_STRIPE_COLOR": "@editorWarning.foreground|@gitDecoration.modifiedResourceForeground" },
    "WRONG_REFERENCES_ATTRIBUTES": { "FOREGROUND": "@editorError.foreground|@errorForeground" },
    "RUNTIME_ERROR": { "EFFECT_COLOR": "@editorError.foreground|@errorForeground", "EFFECT_TYPE": 2 },
    "NOT_USED_ELEMENT_ATTRIBUTES": { "FOREGROUND": "@scope:source.js comment.line.double-slash.js" },
    "FOLDED_TEXT_ATTRIBUTES": { "FOREGROUND": "@scope:source.js comment.line.double-slash.js", "BACKGROUND": "@editor.foldBackground|@editor.rangeHighlightBackground" },
    "INLINE_PARAMETER_HINT": { "FOREGROUND": "@editorInlayHint.foreground|@editorActiveLineNumber.foreground|@editorLineNumber.activeForeground", "BACKGROUND": "@editorInlayHint.background|@editor.lineHighlightBackground" },
    "INLINE_PARAMETER_HINT_HIGHLIGHTED": { "FOREGROUND": "@foreground", "BACKGROUND": "@editor.wordHighlightBackground" },
    "INLINE_PARAMETER_HINT_CURRENT": { "FOREGROUND": "@foreground", "BACKGROUND": "@editor.selectionBackground" },
    "INLAY_DEFAULT": { "FOREGROUND": "@editorInlayHint.foreground|@editorActiveLineNumber.foreground|@editorLineNumber.activeForeground", "BACKGROUND": "@editorInlayHint.background|@editor.lineHighlightBackground" },
    "BREADCRUMBS_DEFAULT": { "FOREGROUND": "@breadcrumb.foreground" },
    "BREADCRUMBS_HOVERED": { "FOREGROUND": "@breadcrumb.focusForeground", "BACKGROUND": "@list.hoverBackground" },
    "BREADCRUMBS_CURRENT": { "FOREGROUND": "@breadcrumb.activeSelectionForeground", "BACKGROUND": "@list.inactiveSelectionBackground" },
    "BREADCRUMBS_INACTIVE": { "FOREGROUND": "@breadcrumb.foreground" },
    "LIVE_TEMPLATE_ATTRIBUTES": { "EFFECT_COLOR": "@focusBorder", "EFFECT_TYPE": 0 },
    "TODO_DEFAULT_ATTRIBUTES": { "FOREGROUND": "@scope:source.js keyword.control.conditional.js", "FONT_TYPE": 3 },
    "DIFF_INSERTED": { "BACKGROUND": "@diffEditor.insertedTextBackground" },
    "DIFF_DELETED": { "BACKGROUND": "@diffEditor.removedTextBackground" },

    "CONSOLE_NORMAL_OUTPUT": { "FOREGROUND": "@terminal.foreground|@syntax:TEXT" },
    "CONSOLE_ERROR_OUTPUT": { "FOREGROUND": "@errorForeground" },
    "CONSOLE_SYSTEM_OUTPUT": { "FOREGROUND": "@scope:source.js comment.line.double-slash.js" },
    "CONSOLE_USER_INPUT": { "FOREGROUND": "@scope:source.js string.quoted.double.js" },
    "CONSOLE_BLACK_OUTPUT": { "FOREGROUND": "@terminal.ansiBlack|@editor.lineHighlightBackground" },
    "CONSOLE_RED_OUTPUT": { "FOREGROUND": "@terminal.ansiRed|@scope:source.js variable.language.this.js" },
    "CONSOLE_GREEN_OUTPUT": { "FOREGROUND": "@terminal.ansiGreen|@scope:source.js string.quoted.double.js" },
    "CONSOLE_YELLOW_OUTPUT": { "FOREGROUND": "@terminal.ansiYellow|@scope:source.js support.class.js" },
    "CONSOLE_BLUE_OUTPUT": { "FOREGROUND": "@terminal.ansiBlue|@scope:source.js entity.name.function.js" },
    "CONSOLE_MAGENTA_OUTPUT": { "FOREGROUND": "@terminal.ansiMagenta|@scope:source.js keyword.control.js" },
    "CONSOLE_CYAN_OUTPUT": { "FOREGROUND": "@terminal.ansiCyan|@scope:source.js keyword.operator.arithmetic.js" },
    "CONSOLE_GRAY_OUTPUT": { "FOREGROUND": "@terminal.ansiWhite|@scope:source.js comment.line.double-slash.js" },
    "CONSOLE_DARKGRAY_OUTPUT": { "FOREGROUND": "@terminal.ansiBrightBlack|@scope:source.js comment.line.double-slash.js<10" },
    "CONSOLE_WHITE_OUTPUT": { "FOREGROUND": "@terminal.ansiBrightWhite|@syntax:TEXT>10" },
    "CONSOLE_RED_BRIGHT_OUTPUT": { "FOREGROUND": "@terminal.ansiBrightRed|@scope:source.js variable.language.this.js>10" },
    "CONSOLE_GREEN_BRIGHT_OUTPUT": { "FOREGROUND": "@terminal.ansiBrightGreen|@scope:source.js string.quoted.double.js>10" },
    "CONSOLE_YELLOW_BRIGHT_OUTPUT": { "FOREGROUND": "@terminal.ansiBrightYellow|@scope:source.js support.class.js>10" },
    "CONSOLE_BLUE_BRIGHT_OUTPUT": { "FOREGROUND": "@terminal.ansiBrightBlue|@scope:source.js entity.name.function.js>10" },
    "CONSOLE_MAGENTA_BRIGHT_OUTPUT": { "FOREGROUND": "@terminal.ansiBrightMagenta|@scope:source.js keyword.control.js>10" },
    "CONSOLE_CYAN_BRIGHT_OUTPUT": { "FOREGROUND": "@terminal.ansiBrightCyan|@scope:source.js keyword.operator.arithmetic.js>10" },

    "LOG_ERROR_OUTPUT": { "FOREGROUND": "@errorForeground" },
    "LOG_WARNING_OUTPUT": { "FOREGROUND": "@editorWarning.foreground|@gitDecoration.modifiedResourceForeground" },
    "LOG_INFO_OUTPUT": { "FOREGROUND": "@terminal.foreground|@syntax:TEXT" },
    "LOG_DEBUG_OUTPUT": { "FOREGROUND": "@scope:source.js comment.line.double-slash.js" },
    "LOG_VERBOSE_OUTPUT": { "FOREGROUND": "@scope:source.js comment.line.double-slash.js" }
  }
}
